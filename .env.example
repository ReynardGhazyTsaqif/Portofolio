# Sanity — dapatkan project ID dari https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# Selama masa transisi, data lama di src/data/ dipakai jika Sanity gagal.
# Set ke "false" setelah Sanity terbukti berjalan agar error state tampil.
VITE_SANITY_FALLBACK=true
